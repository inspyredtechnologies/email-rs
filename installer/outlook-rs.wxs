<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer package for Outlook RS (WiX Toolset v5).
  Build with installer\build-msi.ps1, which passes Version and ExePath.
  UpgradeCode must never change: it lets new versions replace old ones.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Outlook RS"
           Manufacturer="Outlook RS"
           Version="$(var.Version)"
           UpgradeCode="24F3B918-3448-4023-8D93-82FA6F23ADB8"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Outlook RS - Outlook Classic-style mail and calendar client" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The exe carries the icon used for the shortcut and Apps & features. -->
    <Icon Id="AppIcon.exe" SourceFile="$(var.ExePath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/inspyredtechnologies/outlook-rs" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Outlook RS" />
    </StandardDirectory>

    <Feature Id="Main" Title="Outlook RS">
      <Component Directory="INSTALLFOLDER">
        <File Id="OutlookRsExe" Source="$(var.ExePath)" Name="outlook-rs.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Outlook RS"
                    Description="Mail and calendar"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.exe"
                    Advertise="yes" />
        </File>
      </Component>
    </Feature>
  </Package>
</Wix>
